{
  "name": "superpowers",
  "kind": "vendor-source",
  "upstream": {
    "repo": "https://github.com/obra/superpowers.git",
    "ref": "main"
  },
  "sync": {
    "mode": "directory",
    "source_path": "skills",
    "target_path": "vendor/superpowers/skills"
  },
  "filter": {
    "default_policy": "include-all",
    "blacklist": [
      ".experimental"
    ]
  },
  "local": {
    "managed": true,
    "editable": false
  }
}
